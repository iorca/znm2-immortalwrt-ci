# ZN-M2 构建配置种子 (qualcommax / ipq60xx / zn_m2)
# 用法：workflow 把它复制为 openwrt/.config，再 make defconfig 展开。
# 想加/减包，直接在这里加 CONFIG_PACKAGE_xxx=y 行；defconfig 自动处理依赖，
# 不存在的包名会被静默丢弃（不会报错）。

# ---- Target（设备符号以 xdm2211 实际能编过的 ZN-M2 配置为准）----
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y

# ---- Build ----
CONFIG_CCACHE=y
CONFIG_DEVEL=y
CONFIG_BUILD_LOG=y

# ---- Luci ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-commands=y

# ---- OpenClash（来自 vernesong/OpenClash dev 分支，workflow 自动加 feed）----
CONFIG_PACKAGE_luci-app-openclash=y

# ---- 基础工具 ----
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y

# ---- USB 3.0 + 存储（IPQ60xx 用 DWC3 控制器）----
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-dwc3=y
CONFIG_PACKAGE_kmod-usb-dwc3-qcom=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y   # USB 上网卡 / 4G/5G 模组 tty
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y

# ---- NSS / 硬件加速（重要：不要加下面这三个包）----
# 本 fork (VIKINGYFY/immortalwrt) 的 qualcommax 走 in-tree 的 qca_ppe / qca_edma 内核补丁
# (target/linux/qualcommax/patches-6.18: 0952-net-ethernet-qca-add-ppe.patch /
#  0953-net-ethernet-qca-add-EDMA.patch)，加速已编进内核，无需额外包。
# kmod-qca-nss-drv / kmod-qca-nss-ecm / nss-packages 这三个名字在本 fork 不存在，
# 经典 nss-packages feed 默认也是关闭的 (CONFIG_FEED_nss_packages=n)，不要打开。
